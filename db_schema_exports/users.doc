            <body><h1>Database room_utilization_db</h1><h2>Table structure for table users</h2><table width="100%" cellspacing="1"><tr class="print-category"><th class="print">Column</th><td class="print"><strong>Type</strong></td><td class="print"><strong>Null</strong></td><td class="print"><strong>Default</strong></td></tr><tr class="print-category"><td class="print"><em><strong>id</strong></em></td><td class="print">int(11)</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">full_name</td><td class="print">varchar(150)</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print"><strong>email</strong></td><td class="print">varchar(150)</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">password</td><td class="print">varchar(255)</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">role</td><td class="print">enum(&amp;#039;admin&amp;#039;, &amp;#039;faculty&amp;#039;, &amp;#039;student&amp;#039;)</td><td class="print">No</td><td class="print"></td></tr><tr class="print-category"><td class="print">status</td><td class="print">enum(&amp;#039;active&amp;#039;, &amp;#039;inactive&amp;#039;)</td><td class="print">Yes</td><td class="print">active</td></tr><tr class="print-category"><td class="print">created_at</td><td class="print">datetime</td><td class="print">Yes</td><td class="print">current_timestamp()</td></tr><tr class="print-category"><td class="print">updated_at</td><td class="print">datetime</td><td class="print">Yes</td><td class="print">current_timestamp()</td></tr></table><h2>Dumping data for table users</h2><table width="100%" cellspacing="1"><tr class="print-category"><td class="print">1</td><td class="print">chiharu</td><td class="print">quijanoemman99@gmail.com</td><td class="print">$2y$12$MzXDBPqSnJpTFZp8mu0EFeiGgrnuew9Cu4jKejifm3wGhe5o6.9Hm</td><td class="print">student</td><td class="print">active</td><td class="print">2025-11-30 06:54:09</td><td class="print">2025-11-30 06:54:09</td></tr></table></body></html>